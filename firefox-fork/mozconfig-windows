# ZERO Windows derleme konfigi (FULL build - govde degisikligi icin).
# Artifact KAPALI: XUL/CSS/JS yamalari ve branding kaynaktan derlenir.
# Sure: GH-hosted sinir 360dk; ilk full build sinira yakin olabilir.
ac_add_options --enable-application=browser
ac_add_options --disable-tests
ac_add_options --enable-optimize
ac_add_options --with-branding=browser/branding/zero
# Binary + profil klasoru adi: firefox.exe -> zero.exe
ac_add_options --with-app-name=zero
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-zero
mk_add_options MOZ_MAKE_FLAGS="-j4"
